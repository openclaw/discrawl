[Unit]
Description=Refresh selected Discord history for Discrawl source %i
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/discrawl/%i

[Service]
Type=oneshot
User=discrawl
Group=discrawl
WorkingDirectory=/var/lib/discrawl/%i
EnvironmentFile=/etc/discrawl/acquisition-%i.env
UnsetEnvironment=GH_TOKEN GITHUB_TOKEN DISCORD_BACKUP_TOKEN DISCRAWL_REMOTE_TOKEN DISCRAWL_PUBLISHER_TOKEN CRAWL_ARCHIVE_PUBLISHER_TOKEN CRAWL_ARCHIVE_READER_TOKEN
ExecStartPre=/usr/bin/python3 -c 'import os,sys; token=os.environ.get("DISCORD_BOT_TOKEN", "").strip(); guild=os.environ.get("DISCRAWL_GUILD_ID", ""); sys.exit(0 if token.removeprefix("Bot ").strip() and guild.isdecimal() else 1)'
ExecStart=/usr/bin/flock --no-fork --nonblock --conflict-exit-code=75 /var/lib/discrawl/%i/acquisition.lock /usr/bin/python3 /usr/local/libexec/discrawl/private_discord_checkpoint.py selected --timeout 1200 --native /usr/local/bin/discrawl --config /var/lib/discrawl/%i/acquisition.toml --selected-manifest /var/lib/discrawl/%i/selected-history.json
TimeoutStartSec=21min
TimeoutStopSec=20s
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/discrawl/%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
CPUQuota=100%
StandardOutput=journal
StandardError=journal
